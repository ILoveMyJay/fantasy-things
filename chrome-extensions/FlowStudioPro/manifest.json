{
   "action": {
      "default_icon": {
         "128": "icons/ICON128.png",
         "16": "icons/ICON16.png",
         "48": "icons/ICON48.png"
      },
      "default_popup": "popup/popup.html",
      "default_title": "Flow Studio Pro - AI影视生图制片厂"
   },
   "background": {
      "service_worker": "background/background.js"
   },
   "content_scripts": [ {
      "js": [ "core/page-bridge.js" ],
      "matches": [ "*://flow.google.com/*" ],
      "run_at": "document_end",
      "world": "MAIN"
   }, {
      "all_frames": false,
      "js": [ "core/flow-automation.js", "core/filename.js", "content-scripts/flow-content.js" ],
      "matches": [ "*://flow.google.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "Google Flow 电影级制片工作室：原生@mention资产对齐、6槽角色+4槽场景双锚点一致性、Markdown表格导入与全自动制片流水线",
   "host_permissions": [ "*://flow.google.com/*", "https://generativelanguage.googleapis.com/*", "<all_urls>" ],
   "icons": {
      "128": "icons/ICON128.png",
      "16": "icons/ICON16.png",
      "48": "icons/ICON48.png"
   },
   "manifest_version": 3,
   "name": "Flow Studio Pro - AI影视生图制片厂",
   "permissions": [ "storage", "tabs", "activeTab", "sidePanel", "downloads", "scripting", "unlimitedStorage", "debugger" ],
   "short_name": "FlowStudioPro",
   "side_panel": {
      "default_path": "sidepanel/sidepanel.html"
   },
   "version": "2.1.0"
}
